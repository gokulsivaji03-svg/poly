POLYCOPY_DATABASE_URL=postgresql+asyncpg://localhost/polycopy
POLYCOPY_EXECUTION_MODE=PAPER
POLYCOPY_RUN_WORKERS=true
POLYCOPY_AUTH_USERNAME=admin
POLYCOPY_AUTH_PASSWORD=change-me
# Generate: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
# POLYCOPY_JWT_SECRET=
POLYCOPY_LIVE_TRADING_ENABLED=false
# Optional public collateral observations, never required for paper mode:
# POLYCOPY_POLYGON_RPC_URL=https://your-polygon-rpc
