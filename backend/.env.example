POLYCOPY_DATABASE_URL=postgresql+asyncpg://localhost/polycopy
POLYCOPY_EXECUTION_MODE=PAPER
POLYCOPY_RUN_WORKERS=true
POLYCOPY_AUTH_USERNAME=admin
POLYCOPY_AUTH_PASSWORD=change-me
# Generate: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
# POLYCOPY_JWT_SECRET=
POLYCOPY_LIVE_TRADING_ENABLED=false
# Public Polygon RPC drives source trade detection and collateral observations.
POLYCOPY_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Optional explicit WebSocket; defaults to the RPC host with a wss:// scheme.
# POLYCOPY_POLYGON_WS_URL=wss://polygon-bor-rpc.publicnode.com

# Copy from pending matchOrders transactions (~0.8 s earlier). Unset: on for PAPER, off for LIVE.
# POLYCOPY_CHAIN_MEMPOOL=true
